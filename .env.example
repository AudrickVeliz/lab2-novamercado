# Variables del compose. Ninguna es obligatoria: sin un archivo .env se usan estos valores.
# Para cambiarlas, copie este archivo como .env (que Git ignora) y edítelo.

# Base del producto (bd-producto)
NOVAMERCADO_BD_USUARIO=novamercado
NOVAMERCADO_BD_CLAVE=novamercado

# Base de MLflow (bd-mlflow)
MLFLOW_BD_USUARIO=mlflow
MLFLOW_BD_CLAVE=mlflow

# Base de metadatos de Airflow (bd-airflow)
AIRFLOW_BD_USUARIO=airflow
AIRFLOW_BD_CLAVE=airflow

# Usuario de Airflow: lo crea airflow-init y lo usa la API para disparar el reentrenamiento
AIRFLOW_USUARIO=airflow
AIRFLOW_CLAVE=airflow

# Secretos de Airflow. Vacío, Airflow no cifra las conexiones (no hay ninguna guardada).
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=novamercado_jwt_secret
