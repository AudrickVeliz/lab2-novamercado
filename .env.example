# Credenciales del producto. No forman parte del repositorio: copie este archivo como .env
# (que Git ignora) y cambie las claves antes de levantar:
#
#   cp .env.example .env
#
# El compose no tiene valores por defecto: si falta una variable, docker compose se detiene y la nombra.

# Base del producto (bd-producto)
NOVAMERCADO_BD_USUARIO=novamercado
NOVAMERCADO_BD_CLAVE=cambie-esta-clave-del-producto

# Base de MLflow (bd-mlflow)
MLFLOW_BD_USUARIO=mlflow
MLFLOW_BD_CLAVE=cambie-esta-clave-de-mlflow

# Base de metadatos de Airflow (bd-airflow)
AIRFLOW_BD_USUARIO=airflow
AIRFLOW_BD_CLAVE=cambie-esta-clave-de-la-base-de-airflow

# Usuario de Airflow: lo crea airflow-init, sirve para entrar a la interfaz (puerto 8080)
# y lo usa la API para disparar el reentrenamiento.
AIRFLOW_USUARIO=airflow
AIRFLOW_CLAVE=cambie-esta-clave-de-airflow

# Secreto con el que Airflow firma sus tokens JWT.
AIRFLOW_JWT_SECRET=cambie-este-secreto-jwt

# Clave Fernet de Airflow. Puede quedar vacía: el producto no guarda conexiones en Airflow.
# Para generar una: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
