# Variables del compose. Ninguna es obligatoria: sin un archivo .env se usan estos valores.
# Para cambiarlas, copie este archivo como .env (que Git ignora) y edítelo.

# Base del producto (bd-producto)
NOVAMERCADO_BD_USUARIO=novamercado
NOVAMERCADO_BD_CLAVE=novamercado

# Base de MLflow (bd-mlflow)
MLFLOW_BD_USUARIO=mlflow
MLFLOW_BD_CLAVE=mlflow
